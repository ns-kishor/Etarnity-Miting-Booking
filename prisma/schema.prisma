generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ AUTH ============

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String   @default("BOARD_MEMBER") // SUPER_ADMIN | BOARD_MEMBER
  name         String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  boardMember  BoardMember?
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id         String    @id @default(cuid())
  email      String
  token      String    @unique
  invitedName String?
  usedAt     DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
}

// ============ BOARD MEMBERS ============

model BoardMember {
  id          String  @id @default(cuid())
  userId      String? @unique
  slug        String  @unique

  // Personal
  name        String
  photoUrl    String
  email       String
  phone       String?
  location    String?

  // Professional
  designation String
  field       String
  bio         String // short professional introduction
  introduction String? // longer bio
  experience  String?
  skills      String  @default("[]") // JSON string[]
  specializations String @default("[]") // JSON string[]
  achievements String @default("[]") // JSON string[]

  // Social
  linkedin    String?
  facebook    String?
  instagram   String?
  github      String?
  website     String?
  portfolio   String?

  // Visibility & status
  isPublic    Boolean @default(true)
  isAvailable Boolean @default(true)
  isActive    Boolean @default(true)
  displayOrder Int    @default(0)

  // Scheduling config
  timezone        String  @default("Asia/Dhaka")
  minNoticeHours  Int     @default(4)
  maxBookingDays  Int     @default(30)
  bufferMinutes   Int     @default(15)
  durations       String  @default("[30,45]") // JSON number[] of enabled durations
  meetingMethods  String  @default("[]") // JSON [{type, enabled, detail}]
  meetingDescription String?
  meetingInstructions String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  availabilityRules    AvailabilityRule[]
  availabilityExceptions AvailabilityException[]
  bookings    Booking[]
}

model AvailabilityRule {
  id            String  @id @default(cuid())
  boardMemberId String
  dayOfWeek     Int // 0 = Sunday ... 6 = Saturday
  startTime     String // "10:00"
  endTime       String  // "17:00"
  isBreak       Boolean @default(false)

  boardMember BoardMember @relation(fields: [boardMemberId], references: [id], onDelete: Cascade)

  @@index([boardMemberId, dayOfWeek])
}

model AvailabilityException {
  id            String  @id @default(cuid())
  boardMemberId String
  date          String // "YYYY-MM-DD"
  type          String  @default("BLOCKED") // BLOCKED | AVAILABLE
  startTime     String? // for AVAILABLE type
  endTime       String?
  note          String?

  boardMember BoardMember @relation(fields: [boardMemberId], references: [id], onDelete: Cascade)

  @@index([boardMemberId, date])
}

// ============ BOOKINGS ============

model Booking {
  id       String @id @default(cuid())
  reference String @unique

  boardMemberId String

  // Visitor personal info
  fullName     String
  email        String
  phone        String
  country      String
  city         String
  address      String
  organization String?
  jobTitle     String
  website      String?
  linkedin     String?
  language     String?
  additionalNotes String?

  // Meeting info
  subject      String
  purpose      String
  description  String
  discussion   String
  outcome      String
  discoverySource String
  discoveryOther  String?

  // Schedule
  date        String // "YYYY-MM-DD"
  startTime   String // "10:00"
  endTime     String
  duration    Int
  method      String // GOOGLE_MEET | ZOOM | MS_TEAMS | PHONE | IN_PERSON
  methodDetail String? // e.g. preferred location for in-person
  timezone    String

  status          String @default("PENDING") // PENDING | APPROVED | REJECTED | COMPLETED | CANCELLED | EXPIRED
  rejectionReason String?
  meetingLink     String?
  approvedAt      DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelledBy     String? // VISITOR | BOARD_MEMBER | ADMIN

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boardMember BoardMember @relation(fields: [boardMemberId], references: [id], onDelete: Cascade)
  emails      EmailLog[]

  @@index([boardMemberId, date, status])
  @@index([status])
  @@index([email])
}

model BookingHold {
  id            String   @id @default(cuid())
  boardMemberId String
  date          String
  startTime     String
  endTime       String
  token         String   @unique
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([boardMemberId, date])
}

// ============ PLATFORM ============

model PlatformSetting {
  id            String  @id @default("singleton")
  companyName   String  @default("Etarnity Global Innovation")
  logoText      String  @default("ETARNITY")
  tagline       String  @default("Connect. Schedule. Collaborate.")
  landingHeadline String @default("Meet the minds behind Etarnity Global Innovation.")
  landingSubtext  String @default("Book a private conversation with our board members — investors, partners and visionaries welcome.")
  bookingInstructions String @default("Please select an available date and time. Your request will be reviewed by the board member before final confirmation.")
  contactEmail  String  @default("contact@etarnity.com")
  footerText    String  @default("© 2026 Etarnity Global Innovation. All rights reserved.")
  seoTitle      String  @default("Etarnity Meeting — Book a Meeting with Our Board")
  seoDescription String @default("Discover the board members of Etarnity Global Innovation and book a meeting directly with your preferred member.")
  defaultTimezone String @default("Asia/Dhaka")
  defaultDurations String @default("[15,30,45,60]")
  maxBookingWindowDays Int @default(30)
  minBookingNoticeHours Int @default(4)
  approvalMode   String @default("MANUAL") // MANUAL | AUTO
  maintenanceMode Boolean @default(false)
  updatedAt     DateTime @updatedAt
}

model AdminLog {
  id        String   @id @default(cuid())
  actorEmail String
  action    String
  details   String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model EmailLog {
  id        String   @id @default(cuid())
  toEmail   String
  subject   String
  html      String
  type      String // BOOKING_SUBMITTED | BOOKING_APPROVED | BOOKING_REJECTED | BOOKING_CANCELLED | NEW_REQUEST | INVITATION | PASSWORD_RESET
  bookingId String?
  status    String   @default("SENT")
  createdAt DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([type])
}
